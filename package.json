{
  "name": "@taggalongtech/org-launcher",
  "description": "One fast, keyboard-first table of every Salesforce org your sf CLI knows.",
  "version": "0.1.1",
  "author": "Taggalong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaggalongTech/org-launcher.git"
  },
  "homepage": "https://github.com/TaggalongTech/org-launcher",
  "bugs": "https://github.com/TaggalongTech/org-launcher/issues",
  "type": "module",
  "exports": "./lib/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/messages",
    "/web",
    "/assets",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "salesforce",
    "sf",
    "sf-plugin",
    "orgs",
    "scratch-org"
  ],
  "dependencies": {
    "@oclif/core": "^5.1.11",
    "@salesforce/core": "^9.4.4",
    "@salesforce/sf-plugins-core": "^13.0.8"
  },
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topicSeparator": " ",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "topics": {
      "launcher": {
        "description": "See and open every org your sf CLI knows."
      }
    },
    "flexibleTaxonomy": true
  },
  "scripts": {
    "build": "tsc -p . --pretty && npm run lint",
    "lint": "eslint src test",
    "test": "tsc -p ./test --pretty && mocha \"test/**/*.test.ts\"",
    "prepack": "npm run build && oclif manifest",
    "postpack": "node -e \"require('fs').rmSync('oclif.manifest.json', {force: true})\""
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@oclif/plugin-help": "^7.0.6",
    "@salesforce/dev-config": "^4.3.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "eslint": "^10.14.0",
    "eslint-config-salesforce-typescript": "^7.0.6",
    "mocha": "^12.0.3",
    "oclif": "^5.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
